### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Setting up Fn keys
set $explorer thunar
set $browser firefox
set $browser_GPT $browser --new-window chatgpt.com
set $brightnessup brightnessctl s +10
set $brightnessdown brightnessctl s 10-
set $volup pactl set-sink-volume @DEFAULT_SINK@ +5%
set $voldown pactl set-sink-volume @DEFAULT_SINK@ -5%
set $volmute pactl set-sink-mute @DEFAULT_SINK@ toggle

# Exit sway
set $exit_sway swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Your preferred terminal emulator
set $term kitty

# Your preferred application launcher
set $menu rofi -show drun

# Set the laptop display
set $laptop eDP-1

# Set Screenshots directory
set $screenshot ~/.config/sway/script/screenshot/screenshot.sh
set $screenshot_region ~/.config/sway/script/screenshot/region.sh
set $screenshot_window ~/.config/sway/script/screenshot/active_window.sh

# Set Wallpaper Chooser
set $wallpaper ~/.config/sway/script/wallpaper_chooser.sh
